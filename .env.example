# AgentGate Environment Configuration Example
# Copy to .env and configure as needed.

# Gateway Server Settings
AGENTGATE_HOST=0.0.0.0
AGENTGATE_PORT=8000
AGENTGATE_DB_PATH=agentgate.db

# Dashboard Settings
AGENTGATE_DASHBOARD_PORT=8501
AGENTGATE_API_URL=http://localhost:8000

# Optional LLM Judge / Agent Settings (Disabled by default)
# AGENTGATE_LLM_PROVIDER=openai
# AGENTGATE_LLM_API_KEY=your-api-key-here
